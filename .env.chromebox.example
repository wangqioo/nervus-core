# Nervus ChromeOS / Crostini environment
# Copy to core/arbor/.env on the Chromebox Crostini container.

# Arbor runs as a single process with local SQLite.
ARBOR_PORT=8090
DATA_DIR=data
DB_PATH=data/nervus.db

# The Chromebox is not the default model runtime. Point this at a remote
# llama.cpp server if you have one, or leave it unused and rely on cloud APIs.
LLM_URL=http://remote-model-host:8080

# Cloud model keys. Leave blank to keep a provider offline.
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MINIMAX_API_KEY=

# Chromebox control widget
CHROMEBOX_CTL=../../../chromebox-boxy-rev3-lab/scripts/chromeboxctl
CHROMEBOX_HOST=chromebox
CHROMEBOX_SSH_CONNECT_TIMEOUT=8
